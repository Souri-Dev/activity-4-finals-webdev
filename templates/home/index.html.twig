<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>RESTRICTED ACCESS - HelpDesk Core</title>
		<style>
			body {
				background-color: #0a0a0a;
				color: #00ff00;
				font-family: 'Courier New', Courier, monospace;
				margin: 0;
				padding: 40px;
				display: flex;
				justify-content: center;
				align-items: center;
				height: 100vh;
				overflow: hidden;
			}
			.terminal-box {
				border: 2px solid #333;
				background-color: #111;
				padding: 30px;
				width: 100%;
				max-width: 800px;
				box-shadow: 0 0 20px rgba(0, 255, 0, 0.1);
			}
			.warning-banner {
				background-color: #ff0000;
				color: #fff;
				font-weight: bold;
				text-align: center;
				padding: 10px;
				margin-bottom: 20px;
				letter-spacing: 2px;
			}
			.welcome-block {
				background-color: #1a1a1a;
				border-left: 4px solid #00ff00;
				padding: 15px;
				margin-bottom: 30px;
			}
			.welcome-block h2 {
				margin: 0 0 10px;
				color: #fff;
			}
			.welcome-block p {
				margin: 0;
				color: #888;
			}
			h1 {
				color: #00ff00;
				border-bottom: 1px solid #333;
				padding-bottom: 10px;
				font-size: 1.5em;
			}
			.diagnostic-row {
				display: flex;
				justify-content: space-between;
				margin-bottom: 15px;
				border-bottom: 1px dashed #333;
				padding-bottom: 5px;
				font-size: 1.1em;
			}
			.pass {
				color: #00ff00;
				font-weight: bold;
			}
			.fail {
				color: #ff0000;
				font-weight: bold;
			}
		</style>
	</head>
	<body>

		<div class="terminal-box">
			<div class="warning-banner">SYSTEM LOCKDOWN INITIATED</div>

			<div class="welcome-block">
				<h2>>_ WELCOME,
					{{ userName|upper }}</h2>
				<p>Authentication:
					<span class="fail">PENDING</span>
					| Connection IP:
					{{ clientIp }}</p>
			</div>

			<h1>HelpDesk Mainframe // System Diagnostics</h1>

			<div class="diagnostic-row">
				<span>Milestone 0: Dashboard Initialized</span>
				<span class="pass">[ PASS ]</span>
			</div>

			<div class="diagnostic-row">
				<span>Milestone 1A: Database Connection</span>
				{% if db_connected %}
					<span class="pass">[ PASS ]</span>
				{% else %}
					<span class="fail">[ FAIL ]</span>
				{% endif %}
			</div>

			<div class="diagnostic-row">
				<span>Milestone 1B: User & Ticket Entities Generated</span>
				{% if user_table and ticket_table %}
					<span class="pass">[ PASS ]</span>
				{% else %}
					<span class="fail">[ FAIL ]</span>
				{% endif %}
			</div>

			<div class="diagnostic-row">
				<span>Milestone 3: Web CRUD Controllers Created</span>
				{% if crud_exists %}
					<span class="pass">[ PASS ]</span>
				{% else %}
					<span class="fail">[ FAIL ]</span>
				{% endif %}
			</div>

			<div class="diagnostic-row">
				<span>Milestone 4: JWT SSL Keys Generated</span>
				{% if jwt_keys %}
					<span class="pass">[ PASS ]</span>
				{% else %}
					<span class="fail">[ FAIL ]</span>
				{% endif %}
			</div>

			<div style="margin-top: 30px; color: #888; font-size: 0.9em;">
				<p>>> NOTE: To verify Milestone 2 (Email Auth) and API Security constraints, manually test the `/register` and `POST /api/tickets` routes.</p>
			</div>
		</div>

	</body>
</html>
